# Copy this file to .env and replace every CHANGE_ME value locally.
# Never commit real API keys, passwords, internal endpoints, or key files.

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=agent
MYSQL_USER=agent
MYSQL_PASSWORD=CHANGE_ME
MYSQL_PORT=3306

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=5002
FRONTEND_PORT=8081
OCR_PORT=8000
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
MILVUS_TOKEN=
MILVUS_DB_NAME=
REDIS_PORT=6379
REDIS_DB=0
ES_URL=http://host.docker.internal:9200

VECTOR_COLLECTION=agent_collection
MAX_CONTENT_LENGTH_MB=512
OCR_LANG=chi_sim+eng
OCR_TIMEOUT_SECONDS=120
AUTO_START_LLM=true

EMBEDDING_LOCAL_MODEL_ID=iic/nlp_gte_sentence-embedding_chinese-large
EMBEDDING_LOCAL_SEQUENCE_LENGTH=512

LLM_CHAT_MODEL=qwen_chat
LLM_PARSE_MODEL=glm_ocr_parse
LLM_EMBEDDING_MODEL=glm_embedding
LLM_RERANK_MODEL=glm_rerank
LLM_TIMEOUT_SECONDS=600
LLM_PARSE_TIMEOUT_SECONDS=60
LLM_CHAT_CONTEXT_MAX_CHARS=200000
LLM_EMBED_CONTEXT_MAX_CHARS=8000

LLM_QWEN_CHAT_MODEL=CHANGE_ME
LLM_QWEN_LOCAL_CHAT_MODEL=CHANGE_ME
LLM_QWEN_LOCAL_CHAT_BASE_URL=CHANGE_ME
LLM_QWEN_LOCAL_CHAT_API_KEY_PATH=/app/agent/agent_backend/llm/temp/key/qwen_key
LLM_QWEN_LOCAL_CHAT_TIMEOUT_SECONDS=600

LLM_DEEPSEEK_OCR_MODEL=CHANGE_ME
LLM_DEEPSEEK_OCR_BASE_URL=CHANGE_ME
LLM_DEEPSEEK_OCR_API_KEY_PATH=/app/agent/agent_backend/llm/temp/key/deepseek_key
